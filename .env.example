# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/oneweb?schema=public"

# Base64 or hex secret used to sign/derive session-related material.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-strong-random-secret"

# Public origin of the app, used to build absolute links (QR targets, emails).
APP_URL="http://localhost:3000"
