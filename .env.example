# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
# On Vercel + Supabase, use the TRANSACTION POOLER string (port 6543, host
# aws-*.pooler.supabase.com, user postgres.<project-ref>), not the direct
# db.<ref>.supabase.co host: the direct host is IPv6-only and Vercel's
# functions can't reach it. See docs/DEPLOYMENT.md.
DATABASE_URL="postgresql://user:password@localhost:5432/oneweb?schema=public"

# Secret used by Auth.js to sign session tokens. At least 32 random bytes.
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-strong-random-secret"

# Public origin of the app, used to build absolute links (QR codes,
# guest activation links, staff sign-in link). No trailing slash.
APP_URL="http://localhost:3000"

# Optional but strongly recommended in production: shared rate-limit
# counters across serverless instances (Upstash Redis, REST API).
# Without these, each instance keeps its own counters.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
